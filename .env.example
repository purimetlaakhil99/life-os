# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/life_os

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
SESSION_SECRET=your_session_encryption_secret_key_32_bytes_long
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# AI Provider Configuration
LLM_PROVIDER=gemini # or mock, openai, etc.
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth & Gmail API (Send birthday wishes & Calendar sync)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@lifeos.local
